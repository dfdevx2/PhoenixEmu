    <string name="acao_dica">Help</string>
    <string name="dica_tema">Changes the app colors. Each theme has its own palette; Dynamic uses your Android colors.</string>
    <string name="dica_amoled">Makes the background pure black on dark themes. On OLED screens this saves battery.</string>
    <string name="dica_acabamento">Picks the material of bars and cards: blurred glass or a simpler, lighter finish.</string>
    <string name="dica_fundo">Uses your own image as the app background.</string>
    <string name="dica_desfoque">How blurred the background image is. Only works on Android 12 or newer.</string>
    <string name="dica_opacidade">How much of the background image shows. Lower opacity reveals more of the theme background.</string>
    <string name="dica_reduzir_efeitos">Removes the glass blur and the motion effects (card entrance, focus zoom, menu transitions). Recommended for weaker devices or if you prefer a static interface.</string>
    <string name="dica_idioma">App language. System follows the Android language. The screen restarts when you change it.</string>
    <string name="dica_bgm">Background music in the app menus. Does not affect game audio.</string>
    <string name="dica_sfx">Click and navigation sounds in the menus. Does not affect game audio.</string>
    <!-- Individual sound effects -->
    <string name="ajuste_som_capa_passa">Cover scroll sound</string>
    <string name="ajuste_som_capa_passa_desc">Plays a soft tick each time you move from one cover to the next.</string>
    <string name="dica_ajuste_som_capa_passa">Plays a soft tick each time you move from one cover to the next.</string>
    <string name="ajuste_som_troca_aba">Section switch sound</string>
    <string name="ajuste_som_troca_aba_desc">Plays a sound when you switch section (Library, Achievements…).</string>
    <string name="dica_ajuste_som_troca_aba">Plays a sound when you switch section (Library, Achievements…).</string>
    <string name="ajuste_som_boot">Startup sound</string>
    <string name="ajuste_som_boot_desc">Plays the intro sound when the app starts.</string>
    <string name="dica_ajuste_som_boot">Plays the intro sound when the app starts.</string>
    <string name="ajuste_som_entar_jogo">Game launch sound</string>
    <string name="ajuste_som_entar_jogo_desc">Plays a sound when you open a game.</string>
    <string name="dica_ajuste_som_entar_jogo">Plays a sound when you open a game.</string>
    <string name="dica_proporcao">How the game image fills the screen: 4:3 keeps the original shape, 16:9 fills more, Stretch fills everything.</string>
    <string name="dica_filtro_video">Smooths or stylizes the game image. None keeps pixels sharp.</string>
    <string name="dica_autosalvar">Saves the game state by itself when you leave. Does not use the 4 manual slots.</string>
    <string name="dica_autocarregar">When opening a game, continues from the last automatic state. When off, it starts from the beginning.</string>
    <string name="dica_ombros">With a gamepad, L1 and R1 move to the previous or next section of the navigation bar.</string>
    <string name="dica_hashes">Computes the ROM identifier (CRC32). Helps recognize the game and find the right cover.</string>
    <!-- Grid top bar behavior -->
    <string name="titulo_topo_fixo">Fixed top bar in grid view</string>
    <string name="desc_topo_fixo">Keeps search and filters pinned at the top.</string>
    <string name="dica_topo_fixo">On, search and filters stay pinned and the cover grid scrolls in its own area below them, never behind. Off, the bar hides while you scroll and returns when you scroll up.</string>
    <!-- Shadows -->
    <string name="titulo_sombras">Shadows</string>
    <string name="desc_sombras">Soft shadow under floating bars and buttons.</string>
    <string name="dica_sombras">Turns on a light shadow under the navigation bar, search and floating buttons. When off, only the glass edge separates elements from the background.</string>
    <!-- Hide navigation when scrolling down -->
    <string name="titulo_nav_oculta">Hide navigation when scrolling down</string>
    <string name="desc_nav_oculta">In grid view, the navigation bar hides while you move down the games.</string>
    <string name="dica_nav_oculta">While you move down the game grid, the navigation bar and the add-folder button get out of the way and return when you move up. L1 and R1 also bring the bar back.</string>
